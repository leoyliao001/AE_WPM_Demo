# Python
__pycache__/
*.py[cod]

.env
.venv/
venv/

# Node / frontend — dependencies & build artifacts (do NOT commit)
node_modules/
frontend/node_modules/
frontend/node_modules.*/
dist/
frontend/dist/
temp-dist*/
.vite/
frontend/.vite/
frontend/.vite-cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# Run output from the MSSQL ops scripts - regenerated on every run, machine-specific.
# (mssql_migrate_log.txt predates this rule and stays tracked.)
backend/scripts/*_log.txt

# backend/db.sqlite3 IS versioned on purpose - the demo data ships with the repo.
# Everything else sqlite-shaped is not: stray copies, journals, WAL/SHM files.
*.sqlite3
!backend/db.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Env / local overrides
.env.*
!.env.example
*.local

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store

# Local tooling (do not commit)
.tools/

# Local CA bundle (generated from corporate cert, do not commit)
combined-ca.pem
backend/db.sqlite3
