# LLM config used by the migration chatbot.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_SSL_VERIFY=true
LLM_HTTP_PROXY=

# SendGrid config used by Django email notifications.
DJANGO_SENDGRID_API_KEY=
DJANGO_CA_BUNDLE=E:\AE_WPM_Demo\backend\corporate_ca_bundle.pem

# Frontend Azure SSO config. These values are read by Vite at build/dev time.
# Use the tenant ID/name from the Azure app registration instead of `common`
# when the app registration is single-tenant.
# VITE_AZURE_REDIRECT_URI is also the canonical browser origin for real SSO.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=https://wpmpulse.crb.apmoller.net/